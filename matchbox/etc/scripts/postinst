#!/bin/sh
set -e

case "$1" in
    configure)
        # Create 'matchbox' system group if it doesn't exist
        if ! getent group matchbox >/dev/null; then
            groupadd --system matchbox
        fi

        # Create 'matchbox' system user if it doesn't exist
        if ! getent passwd matchbox >/dev/null; then
            useradd --system \
                --gid matchbox \
                --no-create-home \
                --shell /bin/false \
                --comment "Matchbox PXE Server" \
                matchbox
        fi

        # Ensure runtime and configuration directories exist with strict permissions
        mkdir -p /var/lib/matchbox/assets
        mkdir -p /etc/matchbox

        # Set correct ownership on target directories
        chown -R matchbox:matchbox /var/lib/matchbox /etc/matchbox
        chmod 755 /var/lib/matchbox
        chmod 700 /etc/matchbox

        # Reload systemd to pick up the new unit file
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

exit 0