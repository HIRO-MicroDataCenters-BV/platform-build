#cloud-config

autoinstall:
  version: 1

  identity:
    hostname: {{.hostname}}
    username: {{.username}}
    password: "{{.password_hash}}"

  locale: en_US.UTF-8
  keyboard:
    layout: us

  ssh:
    install-server: true
    allow-pw: true

  late-commands:
    - curtin in-target -- systemctl enable ssh
